# Storage driver: auto (default) tries MongoDB then falls back to a local
# JSON file store; mongo makes an unreachable MongoDB a hard boot failure;
# file skips MongoDB entirely. Use mongo in production so a misconfigured
# database never silently degrades to a single-process file store.
STORAGE=auto

# Credentials must match MONGO_USERNAME/MONGO_PASSWORD in the root .env, which
# is what docker-compose.yml passes to the container.
#
# authSource=admin because the root user lives in the admin database — without
# it, authentication fails even with the correct password.
#
# If your password contains characters outside [A-Za-z0-9], percent-encode them
# here, or generate an alphanumeric one to avoid the problem entirely.
MONGODB_URI=mongodb://admin:replace-me-with-a-generated-secret@localhost:27017/scam-sentinel?authSource=admin
MONGODB_DB=scam-sentinel

# How long to wait for MongoDB before falling back (milliseconds).
MONGODB_TIMEOUT_MS=3000

PORT=3001
NODE_ENV=development
