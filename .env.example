# ── Frontend ────────────────────────────────────────────────────────────────
# Express backend the dashboard talks to. Defaults to http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001

# Only needed if you run the Supabase Edge Function backend instead.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── MongoDB (read by docker compose) ────────────────────────────────────────
# Compose reads this file when starting the mongodb service. Both variables are
# required — compose refuses to start without them rather than falling back to
# a guessable default.
#
# Generate a password, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# The same credentials go into MONGODB_URI in server/.env.
MONGO_USERNAME=admin
MONGO_PASSWORD=replace-me-with-a-generated-secret

# NOTE: the backend's MONGODB_URI, PORT and STORAGE live in server/.env.
# See server/.env.example.
